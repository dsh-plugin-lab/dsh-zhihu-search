{
  "name": "dsh-zhihu-search",
  "version": "2.1.2",
  "description": "Zhihu in-site search, global web search, and Zhida answers for the model, over the official Zhihu Open Platform API.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "zhihu",
    "zhihu-api",
    "search",
    "tool"
  ],
  "license": "MIT",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugin-lab/dsh-zhihu-search.git"
  },
  "bugs": {
    "url": "https://github.com/dsh-plugin-lab/dsh-zhihu-search/issues"
  },
  "homepage": "https://github.com/dsh-plugin-lab/dsh-zhihu-search#readme",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/**/*.map",
    "icon.svg",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "README_en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "^0.1.7-rc.1 || ^0.2.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:release": "node scripts/check-release.mjs",
    "check:declaration": "node scripts/check-declaration.mjs",
    "prepare": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-util-values": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.4",
    "@deepseek-ai/dsh-agent": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-util-values": "^0.1.7-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
